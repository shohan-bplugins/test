<script id="html5-player-plyr-js" src="{{ 'plyr-3.7.8.js' | asset_url }}" defer></script>
<script id="html5-player-playlist-plyr-js" src="{{ 'PlyrPlaylist.js' | asset_url }}" defer></script>

<link rel="stylesheet" href="{{ 'plyr-3.7.8.css' | asset_url }}">

<link rel="stylesheet" href="{{ 'style.css' | asset_url }}">

<link id="html5-player-plyr-css" rel="stylesheet" href="{{'player-screen.css' |  asset_url}}">

<script>
// Liquid values for assets/audio-player-bplugins.js (settings, product, shop).
window.APBP_AUTO = {
  enabled: {% if block.settings.auto_inject == false %}false{% else %}true{% endif %},
  isProduct: {% if template.name == 'product' and product %}true{% else %}false{% endif %},
  target: {{ block.settings.auto_target | default: '' | json }},
  ids: {% if template.name == 'product' and product %}{{ product.metafields.audio_player_by_bplugins.assigned_audio_ids.value | default: '[]' | json }}{% else %}[]{% endif %},
  legacyId: {% if template.name == 'product' and product %}{{ product.metafields.audio_player_by_bplugins.assigned_audio_id | default: '' | json }}{% else %}""{% endif %},
  productId: {% if template.name == 'product' and product %}{{ product.id | json }}{% else %}null{% endif %},
  shop: {{ shop.permanent_domain | json }}
};
window.APBP_SHOP = {{ shop.permanent_domain | json }};
window.APBP_BLOCK_ID = {{ block.id | json }};
</script>
<script src="{{ 'audio-player-bplugins.js' | asset_url }}" defer></script>

  {% schema %}
  {
    "name": "Audio Player by bPlugins",
    "target": "body",
    "settings": [
      {
        "type": "header",
        "content": "Product page auto-display"
      },
      {
        "type": "paragraph",
        "content": "For themes that don't let you add the Product Audio block (e.g. Prestige), this automatically shows the player(s) assigned to a product on its product page."
      },
      {
        "type": "checkbox",
        "id": "auto_inject",
        "label": "Auto-show assigned player on product pages",
        "default": true
      },
      {
        "type": "text",
        "id": "auto_target",
        "label": "Insert after (CSS selector, optional)",
        "info": "Leave blank to auto-detect (after the Add to cart form). Example: .product__info-wrapper"
      }
    ]
  }
  {% endschema %}

