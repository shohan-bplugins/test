  <script>
  
  
    if( typeof controls === "undefined"){
      var controls = [];
    }
  
    function htmlToElement(html) {
      let temp = document.createElement('template');
      temp.innerHTML = html.trim();
      return temp.content.firstChild;
    }
  
    function removeURLParams(url) {
      try {
        let parsedURL = new URL(url);
        return parsedURL.origin + parsedURL.pathname;
      } catch (error) {
        return null;
      }
    }
  
    function validateMediaURL(url) {
      if (url === null) {
        return false;
      }
      // Regular expression to check if URL is valid
      let urlPattern =
        /^(https?:\/\/)?([\da-z.-]+)\.([a-z.]{2,6})(\/[\w .-]*)*\/?$/;
  
      // Supported audio and video file extensions
      let videoExtensions = [
        "mp4",
        "mov",
        "avi",
        "mkv",
        "webm",
        "wmv",
      ]; // video formats
      let audioExtensions = [
        "mp3",
        "wav",
        "ogg",
        "aac",
        "flac", // audio formats
      ]; // video formats
  
      // Check if URL is valid
      if (!urlPattern.test(url)) {
        return false;
      }
  
      // Extract the file name from the URL, ignoring query parameters
      let cleanURL = new URL(url).pathname;
  
      // Extract the file extension from the cleaned URL
      let extension = cleanURL.split(".").pop().toLowerCase();
  
      if(videoExtensions.includes(extension)) {
        return "audio/mp4"
      } else if(audioExtensions.includes(extension)) {
        return "audio/mp3"
      }
      return "audio/mp3"
    }
  
  
  
