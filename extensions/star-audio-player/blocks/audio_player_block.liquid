{% assign is_editor = request.design_mode   %}


 <script>
   const is_editor = {{ is_editor | json }}; 
   const el = document.querySelector('.html5-audio-plyr');
   const shopDomain = el?.dataset?.shop || "{{ shop.permanent_domain | escape }}"
    fetch(`https://shopify-audio-app.bplugins.com/app/api/user?shop=${encodeURIComponent(shopDomain)}`)
      .then(response => response.json())
      .then(data => {
        document.querySelector(".alart-from-audio-plyr-bp-{{ block.id }}").style.display = "none"
         if(data?.userType == 'free') {
            document.querySelector(".player-{{block.id}}").style.display = "none"
            if (is_editor) {
              document.querySelector(".alart-from-audio-plyr-bp-{{ block.id }}").style.display = "flex"
            }
        } else if(data?.userType == 'premium'){
          document.querySelector(".player-{{block.id}}").style.display = "flex"
          document.querySelector(".alart-from-audio-plyr-bp-{{ block.id }}").style.display = "none"
        }
      })
      .catch(error => {
        console.error("Error fetching user data:", error);
      });
  </script>
  
