{% comment %} <div style="width:100%;">
  <div class="html5-audio-plyr" data-id="{{ block.settings.id | escape }}"  data-shop="{{ shop.permanent_domain | escape }}">
    <div class="skeletonLoaderBP">
      <style>

        /* Outer container mimicking the bar's rounded shape */
        .skeleton-player-bar {
            width: 500px; /* Overall width */
            padding: 15px 20px;
            background-color: #ffffff; /* Use white background to mimic the screenshot */
            border-radius: 12px;
            box-shadow: 0px 0px 10px rgb(0 0 0 / 21%);
            display: flex;
            align-items: center;
            max-width: 100%;
            gap: 10px;
        }

        @keyframes shimmer {
    0% {
        background-position: -468px 0;
    }
    100% {
        background-position: 468px 0;
    }
}
        .skeleton-player-bar div {
          display: block !important;
    /* BASE STYLES */
    background-color: #e2e5e7;
    border-radius: 4px; 
    height: 15px; 

    /* ANIMATION STYLES */
    /* The gradient for the 'shimmer' effect */
    background-image: linear-gradient(to right, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%);
    
    /* Animation properties */
    background-repeat: no-repeat;
    background-size: 800px 100%;
    animation-duration: 1.2s;
    animation-fill-mode: forwards;
    animation-iteration-count: infinite;
    animation-name: shimmer !important;
}

        /* Specific dimensions for the elements */

        /* 1. Play Button Placeholder */
        .skeleton-play-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%; /* Make it circular or square, depending on preference */
        }

        /* 2. Main Progress Slider */
        .skeleton-progress-bar {
            flex-grow: 1; /* Takes up most of the available space */
            height: 8px; /* Thinner for a slider look */
            border-radius: 4px;
        }

        /* 3. Time Stamp (00:00) */
        .skeleton-time {
            width: 40px;
            height: 12px;
            margin-right: 15px;
        }

        /* 4. Volume Icon */
        .skeleton-volume-icon {
            width: 15px;
            height: 15px;
            border-radius: 50%; 
        }

        /* 5. Volume Slider */
        .skeleton-volume-bar {
            width: 80px;
            height: 8px;
            border-radius: 4px;
        }

        /* 6. Settings Icon */
        .skeleton-settings-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
        }


        /* --- THE SHIMMERING ANIMATION EFFECT --- */

    

        /* Apply the gradient and animation to all structure elements */
        .skeleton-player-bar div {
            /* The gradient for the 'shimmer' effect */
            background-image: linear-gradient(to right, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%);
            
            /* Animation properties */
            background-repeat: no-repeat;
            background-size: 800px 100%;
            animation-duration: 1.2s;
            animation-fill-mode: forwards;
            animation-iteration-count: infinite;
            animation-name: shimmer !important;
        }
    </style>
    <div class="skeleton-player-bar">
        <div class="skeleton-play-icon"></div>
        <div class="skeleton-progress-bar"></div>
        <div class="skeleton-time"></div>
        <div class="skeleton-volume-icon"></div>
        <div class="skeleton-volume-bar"></div>
        <div class="skeleton-settings-icon"></div>
    </div>
    </div>
  </div>
</div> {% endcomment %}

<div style="width: 100%;">
    <div class="html5-audio-plyr" data-id="{{ block.settings.id | escape }}" data-shop="{{ shop.permanent_domain |  escape }}">
        <div class="skeletonLoaderBP">
                    <style>
                                        /* Base container for the skeleton */
                       
.h5ap_lp {
    width: 100%;
    max-width: 100%;
    padding: 1rem;
    border: 1px solid #ddd;
    margin: 10px auto;
    background-color: #fff;
    border-radius: 6px;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.06), 0px 1px 3px rgba(0, 0, 0, 0.05);
}

.bar {
    position: relative;
    width: 100%;
    height: 0.5rem;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-radius: 5px;
    background-color: #d0d8dd;
    display: block !important;
}

.bar:last-child {
    margin-bottom: 0;
}

.bar:after {
    content: "";
    display: block;
    position: absolute;
    height: 100%;
    width: 6rem;
    top: 0;
    animation: load 2s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
    background-image: linear-gradient(to right,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.5) 50%,
            rgba(255, 255, 255, 0) 100%);
}

@keyframes load {
    from {
        left: -100px;
    }

    to {
        left: 100%;
    }
}
                    </style>
           <div class='h5ap_lp'>
            <div class='bar bar-1'></div>
            <div class='bar bar-1'></div>
        </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Audio Player by bPlugins",
  "target": "section",
  "settings": [{ "type": "text", "id": "id", "label": "Audio Player Id" }]
}
{% endschema %}
