{% case block.settings.shadow_preset %}
  {% when 'soft' %}
    {% assign shadow = '0 4px 12px rgba(0,0,0,0.12)' %}
  {% when 'medium' %}
    {% assign shadow = '0 8px 24px rgba(0,0,0,0.18)' %}
  {% when 'strong' %}
    {% assign shadow = '0 12px 36px rgba(0,0,0,0.25)' %}
  {% else %}
    {% assign shadow = 'none' %}
{% endcase %}

{% assign border_type = block.settings.border_type %}
{% assign bw = block.settings.border_width %}
{% assign bc = block.settings.border_color %}
{% assign br = block.settings.border_radius %}

{% if border_type != 'none' and bw > 0 %}
  {% assign border = bw | append: 'px ' | append: border_type | append: ' ' | append: bc %}
{% else %}
  {% assign border = 'none' %}
{% endif %}

<div style="width: {{block.settings.width}}%; height: {{block.settings.height}}px; box-shadow: {{ shadow }}; margin-top: {{ block.settings.marginTB }}px; margin-bottom: {{ block.settings.marginTB }}px; overflow: hidden; border-radius: {{ block.settings.borderRadius }}px; border: {{ border }};">
  {%- comment -%} The URL is url_encoded into a fixed https://w.soundcloud.com query param, so it can't inject; only skip blank values. {%- endcomment -%}
  {%- assign sc_url_value = block.settings.url | strip -%}
  {%- if sc_url_value != blank -%}
  <iframe
    id="sc-widget-{{ block.id }}"
    width="100%"
    height="100%"
    scrolling="no"
    frameborder="0"
    allow="autoplay"
    src="https://w.soundcloud.com/player/?url={{ block.settings.url | url_encode }}&color=%23{{ block.settings.color | remove: '#' | slice: 0, 6 }}&auto_play={{ block.settings.isAutoPlay }}&buying={{ block.settings.isBuying }}&sharing={{ block.settings.isSharing }}&download={{ block.settings.isDownload }}&show_artwork={{ block.settings.isArtWork }}&show_playcount={{ block.settings.isPlayCount }}&show_user={{ block.settings.isUser }}&single_active={{ block.settings.isSingleActive }}&show_comments={{ block.settings.isComments }}&visual={{ block.settings.isVisual }}&show_teaser={{ block.settings.isTeaser }}&hide_related={{ block.settings.isHideRelated }}&start_track={{ block.settings.startTrack }}"
  >
  </iframe>
  {%- endif -%}
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const scBlock = document.querySelector('#shopify-block-{{block.id}}');

    if (scBlock) {
      scBlock.style.width = '100%';
      scBlock.style.maxWidth = '100%';
    }
  });
</script>

{% schema %}
{
  "name": "SoundCloud Block",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "SoundCloud Setting"
    },
    {
      "type": "text",
      "id": "url",
      "label": "Url",
      "default": "https://soundcloud.com/md-shohanur-rahman-337592458/hype-drill-music"
    },
    { "type": "number", "id": "width", "label": "Width (%)", "default": 100 },
    { "type": "number", "id": "height", "label": "Height (px)", "default": 170 },
    {
      "type": "number",
      "id": "startTrack",
      "label": "Start Track",
      "default": 0
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Theme Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "marginTB",
      "label": "Padding Top & Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "shadow_preset",
      "label": "Shadow",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "soft", "label": "Soft" },
        { "value": "medium", "label": "Medium" },
        { "value": "strong", "label": "Strong" }
      ]
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "paragraph",
      "content": "Select a border type. Other settings apply only when enabled."
    },
    {
      "type": "select",
      "id": "border_type",
      "label": "Border type",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" },
        { "value": "double", "label": "Double" }
      ]
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "borderRadius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "isAutoPlay",
      "label": "Enable Auto Play",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isSingleActive",
      "label": "Single Active",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isVisual",
      "label": "Visual",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isTeaser",
      "label": "Teaser",
      "default": false
    },
    {
      "type": "header",
      "content": "Elements"
    },
    {
      "type": "checkbox",
      "id": "isBuying",
      "label": "Buying",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isSharing",
      "label": "Sharing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isDownload",
      "label": "Download",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isArtWork",
      "label": "Art Work",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isPlayCount",
      "label": "Play Count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isUser",
      "label": "User",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isComments",
      "label": "Comments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isHideRelated",
      "label": "Hide Related",
      "default": true
    }
  ]
}
{% endschema %}
