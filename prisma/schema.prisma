// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppUser {
  id                   String   @id @default(uuid())
  shop                 String   @unique
  planId               String?
  chargeId             String?
  modelLimit           Int      @default(5)
  onboardingStep       Int      @default(0)
  onboardingDone       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Charge {
  id           String   @id @default(uuid())
  shop         String
  name         String
  price        String
  status       String
  modelLimit   Int?
  activatedOn  String?
  trialDays    String?
  cancelledOn  String?
  billingOn    String?
  planId       String?
  chargeId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Model3D {
  id        String   @id @default(uuid())
  shop      String
  name      String
  fileGid   String
  fileUrl   String
  fileSize  Int?
  config    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, createdAt])
}

model WebhookCall {
  id       String   @id @default(uuid())
  shop     String   @unique
  called   Boolean  @default(false)
  calledAt DateTime @default(now())
}

model Plan {
  id           String   @id @default(uuid())
  title        String
  name         String   @unique
  description  String?
  features     String
  price        String
  currencyCode String
  trialDays    String?
  modelLimit   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
