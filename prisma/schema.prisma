// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  // url comes from the DATABASE_URL environment variable
}

model Session {
  session_id          String    @id @default(auto()) @map("_id") @db.ObjectId
  id                  String    @unique
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  firstName           String?
  lastName            String?
  email               String?
  locale              String?
  scope               String?
  expires             DateTime?
  accessToken         String
  accountOwner        Boolean   @default(false)
  collaborator        Boolean   @default(false)
  emailVerified       Boolean   @default(false)
  userId              BigInt?
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WebhookCall {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  shop     String   @unique
  called   Boolean  @default(false)
  calledAt DateTime @default(now())
}

model Analytics {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId     String?
  audioId       String
  shop          String
  event         String
  duration      Int
  currentTime   Int?
  totalDuration Int?
  ipAddress     String?
  country       String?
  userAgent     String
  device        String
  browser       String
  calledAt      DateTime @default(now())
}

// Core Web Vitals reported by App Bridge from merchants' admin sessions.
// One row per metric per page load (re-reports of the same metric update it).
model WebVital {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shop      String
  path      String
  name      String // LCP | CLS | INP | FCP | TTFB
  value     Float
  rating    String // good | needs-improvement | poor
  metricId  String
  appLoadId String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, metricId])
  @@index([shop, name, createdAt])
  @@index([name, createdAt])
}

model Users {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shop      String   @unique
  planId    String?
  chargeId  String?
  cardits      Int?
  // true once the shop has picked a plan. Unset/false on a Free shop = sees
  // only the Pricing page until it picks one. Paid shops are never gated.
  planSelected Boolean?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Charges {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  shop         String
  name         String
  price        String
  status       String
  cradit       Int?
  activated_on String?
  trial_days   String?
  cancelled_on String?
  billing_on   String?
  planId       String?
  chargeId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plans {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  features     Json
  price        String
  currencyCode String
  options      Json?
  trial_days   String?
  cradit       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Audio {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  shop           String
  title          String
  url            String
  audioPlayList  Json?
  mainColor      String
  screenDefault  Json
  screenOne      Json
  screenTwo      Json
  selectedScreen String
  playerType     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Screen {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  shop            String
  title           String
  controls        Json
  width           String
  height          String
  borderWidth     String?
  borderStyle     String?
  borderColor     String?
  borderRadius    String?
  iconSize        String?
  iconColor       String?
  background      String?
  backgroundImage String?
  image           String?
  margin          String?
  padding         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One row per in-app review request (shopify.reviews.request()). `shown` is
// true when Shopify actually displayed the popup; `code` is Shopify's reason
// when it didn't (e.g. "already-reviewed", "cooldown-period").
model ReviewPrompt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shop      String
  shown     Boolean
  code      String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
